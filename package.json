{
  "name": "tikitoki",
  "version": "1.3.0",
  "description": "Telegram bot that downloads TikTok, Instagram, and Twitter/X videos, renders slideshows, and X feed cards",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "xrender:frames": "tsx --env-file=.env scripts/xrender-visual-suite.ts"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "grammy": "^1.45.1",
    "p-queue": "^9.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "telegram",
    "bot",
    "tiktok",
    "instagram",
    "twitter",
    "slideshow",
    "ffmpeg",
    "yt-dlp"
  ],
  "license": "MIT"
}
