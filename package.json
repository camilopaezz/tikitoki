{
  "name": "tikitoki",
  "version": "1.3.0",
  "description": "Telegram bot that downloads TikTok, Instagram, and Twitter/X videos, renders slideshows, and X feed cards",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "xrender:frames": "tsx --env-file=.env scripts/xrender-visual-suite.ts",
    "xrender:bench": "tsx --env-file=.env scripts/bench-xrender.ts",
    "xrender:fonts": "tsx scripts/fetch-chirp-fonts.ts"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "grammy": "^1.46.0",
    "p-queue": "^10.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "telegram",
    "bot",
    "tiktok",
    "instagram",
    "twitter",
    "slideshow",
    "ffmpeg",
    "yt-dlp"
  ],
  "license": "MIT"
}
